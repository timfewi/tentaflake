{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "images"],
  "properties": {
    "schemaVersion": {"const": 1},
    "images": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {"pattern": "^[a-z][a-z0-9.-]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/image"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "manifestDigest", "configDigest"],
      "properties": {
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "architecture"],
          "properties": {
            "os": {"const": "linux"},
            "architecture": {"enum": ["amd64", "arm64"]},
            "variant": {"const": "v8"}
          }
        },
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "configDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distro", "release", "codename", "label", "repository", "discoveryTag",
        "observedAt", "indexDigest", "sourceUrl", "platforms"
      ],
      "properties": {
        "distro": {"enum": ["debian", "ubuntu"]},
        "release": {"type": "string", "pattern": "^[0-9]{1,2}([.][0-9]{2})?$"},
        "codename": {"type": "string", "pattern": "^[a-z]{1,32}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "repository": {"enum": ["docker.io/library/debian", "docker.io/library/ubuntu"]},
        "discoveryTag": {"type": "string", "pattern": "^[a-z]{1,32}-[0-9]{8}$"},
        "observedAt": {"type": "string", "minLength": 20, "maxLength": 40},
        "indexDigest": {"$ref": "#/$defs/digest"},
        "sourceUrl": {"type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 512},
        "platforms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x86_64-linux", "aarch64-linux"],
          "properties": {
            "x86_64-linux": {"$ref": "#/$defs/platform"},
            "aarch64-linux": {"$ref": "#/$defs/platform"}
          }
        }
      }
    }
  }
}
