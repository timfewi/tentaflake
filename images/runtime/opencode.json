{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "bash": "ask",
    "webfetch": "ask",
    "edit": "allow"
  },
  "provider": {
    "broker": {
      "name": "Tentaflake broker",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:TENTAFLAKE_MODEL_BASE_URL}",
        "apiKey": "{env:TENTAFLAKE_MODEL_API_KEY}"
      }
    }
  }
}
