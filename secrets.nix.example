# Optional consumer-fork module; copy to secrets.nix and import it in
# configuration.nix after enabling the pinned agenix input/module.
# See docs/04-agenix-secrets.md for CLI recipient rules and encryption.
# Decryption happens at activation/boot, never at build time.
# Provision the private identity through a protected runtime channel.
# Never pass this real provider credential into a balanced agent.
{
  age.identityPaths = [ "/var/lib/agenix/identity" ];

  age.secrets.llm-provider = {
    file = ./secrets/llm-provider.age;
    owner = "root";
    group = "root";
    mode = "0400";
  };
}
