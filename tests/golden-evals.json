      "expected_events": [
        "approval-required",
        "approved",
        "completed"
      ]
    },
    {
      "id": "privileged-denial-prevents-execution",
      "action_class": "privileged",
      "decision": "deny",
      "expected_status": "denied",
      "artifacts_available": false,
      "expected_events": [
        "approval-required",
        "denied"
      ]
    },
    {
      "id": "forbidden-never-runs",
      "action_class": "forbidden",
