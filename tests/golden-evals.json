      "action_class": "irreversible",
      "decision": "approve",
      "expected_status": "succeeded",
      "artifacts_available": true,
      "expected_events": [
        "approval-required",
        "approved",
        "completed"
      ]
    },
    {
      "id": "financial-needs-approval",
      "action_class": "financial",
      "decision": "approve",
      "expected_status": "succeeded",
      "artifacts_available": true,
      "expected_events": [
        "approval-required",
        "approved",
        "completed"
      ]
    },
    {
      "id": "production-needs-approval",
      "action_class": "production",
      "decision": "approve",
      "expected_status": "succeeded",
      "artifacts_available": true,
      "expected_events": [
        "approval-required",
        "approved",
        "completed"
      ]
    },
    {
      "id": "communicative-needs-approval",
      "action_class": "communicative",
