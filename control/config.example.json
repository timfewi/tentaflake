{
  "hostname": "127.0.0.1",
  "port": 8080,
  "origin": "https://tentaflake.example",
  "databasePath": "/var/lib/tentaflake/control.sqlite",
  "keyFile": "/var/lib/tentaflake/control.key",
  "setupTokenFile": "/var/lib/tentaflake/setup-token",
  "dockerSocket": "/run/docker.sock",
  "brokerPort": 7810,
  "brokerDirectory": "/run/tentaflake/broker",
  "image": "tentaflake-runtime:0.5",
  "uiDirectory": "/opt/tentaflake/ui",
  "limits": { "memoryMiB": 2048, "cpus": 2, "pids": 512, "dailyTokens": 10000000 },
  "environmentIdleMinutes": 15,
  "sessionIdleMinutes": 60,
  "sessionAbsoluteHours": 12
}
