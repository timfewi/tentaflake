{ mkAgent }:

# Installed systems use the balanced security profile by default. These
# examples create fail-closed capsules and do not inject provider credentials
# or publish services. They stay stopped until an exact broker policy is
# declared and the operator explicitly starts them.
[
  # OpenClaw is a stopped scaffold only; it creates no runtime container.
  (mkAgent {
    adapter = "openclaw";
    name = "preview";
    autoStart = false;
  })
  (mkAgent {
    adapter = "hermes";
    name = "coding";
    autoStart = false;
    gitIdentity = {
      name = "coding-bot";
      email = "coding@example.invalid";
    };
  })

  (mkAgent {
    adapter = "zeroclaw";
    name = "assistant";
    autoStart = false;
    settings.schema_version = 3;
  })

  # Disposable no-egress execution queues. The exact key, workspace, and
  # numeric user are checked against each builder during evaluation.
  {
    tentaflake.worker.agents = {
      agent-coding = {
        enable = true;
        workspace = "/var/lib/tentaflake/agents/coding/workspace";
      };
      agent-assistant = {
        enable = true;
        workspace = "/var/lib/tentaflake/agents/assistant/data";
        containerUid = 65534;
        containerGid = 65534;
      };
    };

    # Fixed-size persistent Btrfs workspaces. Enabling these on a non-empty
    # existing workspace fails closed; follow the migration guide first.
    tentaflake.workspaceQuota.agents = {
      agent-coding = {
        enable = true;
        workspace = "/var/lib/tentaflake/agents/coding/workspace";
        sizeMiB = 8192;
      };
      agent-assistant = {
        enable = true;
        workspace = "/var/lib/tentaflake/agents/assistant/data";
        sizeMiB = 8192;
        ownerUid = 65534;
        ownerGid = 65534;
      };
    };
  }
]
