{
  "name": "tentaflake-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && bun build index.html --outdir dist --production --entry-naming '[name].[ext]' --chunk-naming '[name]-[hash].[ext]'",
    "typecheck": "tsc && tsc -p e2e"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.61.1",
    "typescript": "7.0.2"
  }
}
