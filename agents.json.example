{
  "schemaVersion": 1,
  "agents": [
    {
      "adapter": "hermes",
      "name": "coding",
      "autoStart": false,
      "pidsLimit": 512,
      "settings": {
        "model": {
          "default": "example-model",
          "provider": "custom",
          "base_url": "http://10.203.20.1:7810/v1"
        },
        "agent": {
          "disabled_toolsets": ["web", "browser"]
        }
      }
    },
    {
      "adapter": "zeroclaw",
      "name": "assistant",
      "autoStart": false,
      "pidsLimit": 512,
      "settings": {
        "schema_version": 3,
        "providers": {
          "models": {
            "custom": {
              "default": {
                "model": "example-model",
                "uri": "http://10.203.24.1:7810/v1"
              }
            }
          }
        },
        "runtime_profiles": {
          "default": {
            "agentic": true,
            "max_tool_iterations": 25
          }
        },
        "risk_profiles": {
          "default": {"level": "supervised"}
        },
        "agents": {
          "main": {
            "model_provider": "custom.default",
            "risk_profile": "default",
            "runtime_profile": "default"
          }
        },
        "browser": {"enabled": false},
        "http_request": {"enabled": false},
        "web_fetch": {"enabled": false},
        "web_search": {"enabled": false}
      }
    },
    {"adapter": "openclaw", "name": "preview", "autoStart": false},
    {"adapter": "pi", "name": "scratch", "autoStart": false}
  ],
  "_securityNote": "Inactive examples only: replace example-model and match each broker URL with separately reviewed Nix network, model/pricing, worker, quota and Research policy. Keep credentials host-side. All instances stay stopped; OpenClaw/Pi are refusal scaffolds without runtime settings. No state migration or vendor acceptance is implied."
}
