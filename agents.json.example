{
  "schemaVersion": 1,
  "agents": [
    { "adapter": "hermes", "name": "coding", "autoStart": false },
    { "adapter": "openclaw", "name": "assistant", "autoStart": false }
  ],
  "_securityNote": "The legacy arrays below require an explicit dev profile for direct env files and ports. Generic stopped agents can use balanced.",
  "hermes": [
    {
      "name": "example",
      "provider": "openrouter",
      "model": "example-provider/example-model",
      "base_url": null,
      "envFile": "/var/lib/tentaflake/secrets/hermes-example.env"
    }
  ],
  "zeroclaw": [
    {
      "name": "example",
      "provider": "openrouter",
      "model": "example-provider/example-model",
      "base_url": null,
      "hostPort": 9250,
      "servePort": 9150,
      "envFile": "/var/lib/tentaflake/secrets/zeroclaw-example.env"
    }
  ]
}
