result
result-*
*.tmp
*.bak
.agents.toml.lock
agents.toml.pending

# Local overrides — user secrets and home-manager config.
# Note: agents.toml is intentionally NOT ignored — the flake must evaluate it,
# and flakes only see git-tracked files (run `git add agents.toml`).
home.nix
secrets/*.env

# Personal local agent rules — private, never committed
CLAUDE.local.md
AGENT.local.md

# Editor artifacts
*.swp
*.swo
*~

# Nix
.direnv/
.envrc
.planning

# Rust
/target/

# Python bytecode generated by local checks.
__pycache__/

# Reports
.reports/
# Private keys — never commit unencrypted credentials
# .age files (encrypted by agenix) ARE safe to commit — they go in git
age.key

# Logs
*.log
