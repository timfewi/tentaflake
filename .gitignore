result
result-*
*.tmp
*.bak
.tentaflake.toml.lock
tentaflake.toml.pending

# Local overrides — user secrets and home-manager config.
# The public tentaflake.toml stays an empty commented template. Deployment data
# belongs in a consumer/fork's tracked TOML, not an ignored upstream override.
# It is intentionally NOT ignored: ordinary flakes omit untracked/ignored files.
home.nix
secrets/*.env

# Personal local agent rules — private, never committed
CLAUDE.local.md
AGENT.local.md

# Editor artifacts
*.swp
*.swo
*~

# Nix
.direnv/
.envrc
.planning

# Rust
/target/

# Python bytecode generated by local checks.
__pycache__/

# Reports
.reports/
# Private keys — never commit unencrypted credentials
# .age files (encrypted by agenix) ARE safe to commit — they go in git
age.key

# Logs
*.log
